@model PacienteListViewModel
@{
    ViewData["Title"] = "Pacientes";

    var podeEditar = await Autorizacao.PermiteAsync(User, Politicas.EditarPacientes);
    var podeExcluir = await Autorizacao.PermiteAsync(User, Politicas.ExcluirPacientes);

    const int paginasVisiveis = 5;
    var primeiraPagina = Math.Max(1, Model.PaginaAtual - paginasVisiveis / 2);
    var ultimaPagina = Math.Min(Model.TotalPaginas, primeiraPagina + paginasVisiveis - 1);
    primeiraPagina = Math.Max(1, ultimaPagina - paginasVisiveis + 1);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Pacientes</h1>
    @if (podeEditar)
    {
        <a asp-action="Create" class="btn btn-primary">Novo paciente</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <label for="busca" class="visually-hidden">Pesquisar pacientes</label>
        <input type="search" id="busca" name="busca" value="@Model.Busca" class="form-control"
               placeholder="Pesquisar por nome, CPF ou telefone" maxlength="200" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Pesquisar</button>
        @if (!string.IsNullOrEmpty(Model.Busca))
        {
            <a asp-action="Index" class="btn btn-link">Limpar</a>
        }
    </div>
</form>

@if (Model.Pacientes.Count == 0)
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(Model.Busca))
        {
            <text>Nenhum paciente encontrado para "@Model.Busca".</text>
        }
        else if (Model.TotalRegistros > 0)
        {
            <text>Nenhum resultado encontrado nesta página.</text>
        }
        else
        {
            <text>Nenhum paciente cadastrado.</text>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Nome completo</th>
                    <th scope="col">CPF</th>
                    <th scope="col">Telefone</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Data de cadastro</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paciente in Model.Pacientes)
                {
                    <tr>
                        <td>@paciente.NomeCompleto</td>
                        <td>@paciente.Cpf</td>
                        <td>@paciente.Telefone</td>
                        <td>@paciente.Email</td>
                        <td>@paciente.DataCadastro</td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@paciente.Id" class="btn btn-sm btn-outline-secondary">Visualizar</a>
                            @if (podeEditar)
                            {
                                <a asp-action="Edit" asp-route-id="@paciente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            }
                            @if (podeExcluir)
                            {
                                <a asp-action="Delete" asp-route-id="@paciente.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginação de pacientes" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">
            @Model.TotalRegistros paciente(s) · página @Model.PaginaAtual de @Model.TotalPaginas
        </span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.PaginaAtual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
            </li>
            @for (var pagina = primeiraPagina; pagina <= ultimaPagina; pagina++)
            {
                <li class="page-item @(pagina == Model.PaginaAtual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-pagina="@pagina">@pagina</a>
                </li>
            }
            <li class="page-item @(Model.PaginaAtual >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
            </li>
        </ul>
    </nav>
}
else if (Model.TotalRegistros > 0)
{
    <p class="text-muted small">@Model.TotalRegistros paciente(s)</p>
}
