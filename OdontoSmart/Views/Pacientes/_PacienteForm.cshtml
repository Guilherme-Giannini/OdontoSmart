@model PacienteFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="NomeCompleto" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="NomeCompleto" class="form-control" autocomplete="off" />
        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Cpf" class="form-label"></label>
        <input asp-for="Cpf" class="form-control" inputmode="numeric" placeholder="000.000.000-00" autocomplete="off" />
        <span asp-validation-for="Cpf" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DataNascimento" class="form-label"></label>
        <input asp-for="DataNascimento" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DataNascimento" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Sexo" class="form-label"></label>
        <select asp-for="Sexo" asp-items="PacienteFormatacao.OpcoesSexo" class="form-select">
            <option value="">Não informado</option>
        </select>
        <span asp-validation-for="Sexo" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" type="tel" class="form-control" placeholder="(00) 00000-0000" />
        <span asp-validation-for="Telefone" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="paciente@exemplo.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Observacoes" class="form-label"></label>
        <textarea asp-for="Observacoes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Observacoes" class="text-danger small"></span>
    </div>
</div>
