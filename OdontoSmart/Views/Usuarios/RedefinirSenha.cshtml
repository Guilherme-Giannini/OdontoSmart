@model UsuarioRedefinirSenhaViewModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<h1 class="h3 mb-3">Redefinir senha</h1>

<div class="alert alert-info" role="alert">
    Defina uma senha temporária para <strong>@Model.NomeCompleto</strong> (@Model.Email).
    No próximo acesso, o usuário deverá trocá-la. As sessões abertas dele serão encerradas
    e um eventual bloqueio por tentativas será removido.
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="RedefinirSenha" asp-route-id="@Model.Id" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NovaSenha" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
                        <div class="form-text">De 8 a 128 caracteres, com pelo menos uma letra e um número.</div>
                        <span asp-validation-for="NovaSenha" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmacaoNovaSenha" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="ConfirmacaoNovaSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmacaoNovaSenha" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Redefinir senha</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
