@model UsuarioListViewModel
@{
    ViewData["Title"] = "Usuários";

    const int paginasVisiveis = 5;
    var primeiraPagina = Math.Max(1, Model.PaginaAtual - paginasVisiveis / 2);
    var ultimaPagina = Math.Min(Model.TotalPaginas, primeiraPagina + paginasVisiveis - 1);
    primeiraPagina = Math.Max(1, ultimaPagina - paginasVisiveis + 1);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a asp-action="Create" class="btn btn-primary">Novo usuário</a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-3" role="search">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label for="busca" class="form-label small mb-1">Usuário</label>
            <input type="search" id="busca" name="busca" value="@Model.Busca" class="form-control"
                   placeholder="Nome ou e-mail" maxlength="200" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label for="situacao" class="form-label small mb-1">Situação</label>
            <select id="situacao" name="situacao" class="form-select"
                    asp-items="UsuarioFormatacao.OpcoesSituacao(Model.Situacao)"></select>
        </div>
        <div class="col-sm-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Pesquisar</button>
            @if (Model.PossuiFiltros)
            {
                <a asp-action="Index" class="btn btn-link px-1">Limpar</a>
            }
        </div>
    </div>
</form>

@if (Model.Usuarios.Count == 0)
{
    <div class="alert alert-info">
        @if (Model.PossuiFiltros)
        {
            <text>Nenhum usuário encontrado para os filtros informados.</text>
        }
        else if (Model.TotalRegistros > 0)
        {
            <text>Nenhum resultado encontrado nesta página.</text>
        }
        else
        {
            <text>Nenhum usuário ativo.</text>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Nome completo</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Perfil</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Último acesso</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>
                            @usuario.NomeCompleto
                            @if (usuario.EhUsuarioAtual)
                            {
                                <span class="text-muted small">(você)</span>
                            }
                        </td>
                        <td>@usuario.Email</td>
                        <td>
                            <span class="badge rounded-pill @UsuarioFormatacao.ClassePerfil(usuario.Perfil)">@UsuarioFormatacao.Perfil(usuario.Perfil)</span>
                        </td>
                        <td>
                            <span class="badge rounded-pill @UsuarioFormatacao.ClasseSituacao(usuario.Ativo, usuario.Bloqueado)">@UsuarioFormatacao.Situacao(usuario.Ativo, usuario.Bloqueado)</span>
                        </td>
                        <td class="text-nowrap">@usuario.UltimoAcesso</td>
                        <td class="text-end acoes">
                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (!usuario.EhUsuarioAtual)
                            {
                                <a asp-action="RedefinirSenha" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-secondary">Redefinir senha</a>

                                <form asp-action="AlterarAtivo" asp-route-id="@usuario.Id" method="post" class="d-inline"
                                      data-confirmacao="@(usuario.Ativo
                                          ? $"Deseja desativar o usuário {usuario.NomeCompleto}? Ele perderá o acesso ao sistema."
                                          : $"Deseja reativar o usuário {usuario.NomeCompleto}?")">
                                    <input type="hidden" name="ativo" value="@(usuario.Ativo ? "false" : "true")" />
                                    @if (usuario.Ativo)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desativar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reativar</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginação de usuários" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">
            @Model.TotalRegistros usuário(s) · página @Model.PaginaAtual de @Model.TotalPaginas
        </span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.PaginaAtual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="Model.RotaDaPagina(Model.PaginaAtual - 1)">Anterior</a>
            </li>
            @for (var pagina = primeiraPagina; pagina <= ultimaPagina; pagina++)
            {
                <li class="page-item @(pagina == Model.PaginaAtual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.RotaDaPagina(pagina)">@pagina</a>
                </li>
            }
            <li class="page-item @(Model.PaginaAtual >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="Model.RotaDaPagina(Model.PaginaAtual + 1)">Próxima</a>
            </li>
        </ul>
    </nav>
}
else if (Model.TotalRegistros > 0)
{
    <p class="text-muted small">@Model.TotalRegistros usuário(s)</p>
}
