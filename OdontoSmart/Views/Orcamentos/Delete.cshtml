@model OrcamentoDetailsViewModel
@{
    ViewData["Title"] = "Excluir orçamento";
}

<h1 class="h3 mb-3">Excluir orçamento</h1>

<div class="alert alert-danger" role="alert">
    <p class="mb-2">Tem certeza de que deseja excluir este orçamento? Esta ação não poderá ser desfeita.</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Paciente</dt>
        <dd class="col-sm-9">@Model.PacienteNome</dd>
        <dt class="col-sm-3">Valor total</dt>
        <dd class="col-sm-9">@Model.ValorTotal</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Status" /></dd>
        <dt class="col-sm-3">Data do orçamento</dt>
        <dd class="col-sm-9 mb-0">@Model.DataCadastro</dd>
    </dl>
</div>

<partial name="_OrcamentoDados" model="Model" />

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</form>
