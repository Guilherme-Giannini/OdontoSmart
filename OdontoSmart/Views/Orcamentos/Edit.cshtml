@model OrcamentoEditViewModel
@{
    ViewData["Title"] = "Editar orçamento";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Editar orçamento</h1>
    <partial name="_StatusBadge" model="Model.Status" />
    <span class="text-muted small ms-auto">Cadastrado em @OrcamentoFormatacao.DataHora(Model.DataCadastro)</span>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-orcamento-form>
            <partial name="_OrcamentoForm" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/orcamento-form.js" asp-append-version="true"></script>
}
